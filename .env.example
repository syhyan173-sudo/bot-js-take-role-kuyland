# ========================================================
# KONFIGURASI BOT DISCORD KUYLAND ROLEPLAY
# Salin file ini menjadi .env lalu isi nilainya.
#
#   PowerShell : Copy-Item .env.example .env
#   CMD        : copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# CATATAN: File .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).
# File contoh ini hanya berisi placeholder kosong.
# ========================================================

# Token bot Discord
# Discord Developer Portal -> Bot -> Reset Token -> Copy
DISCORD_TOKEN=

# Application / Client ID
# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=

# ID Server Discord Kuyland
# Aktifkan Developer Mode, klik kanan server -> Copy Server ID
GUILD_ID=

# ID Role Warga yang akan diberikan
# Server Settings -> Roles -> klik kanan role Warga -> Copy Role ID
WARGA_ROLE_ID=

